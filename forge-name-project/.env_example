# ============================================
# DATABASE CONFIGURATION - Neon PostgreSQL
# ============================================
# Replace with your actual Neon PostgreSQL database credentials
DB_HOST=your-endpoint.region.aws.neon.tech
DB_PORT=5432
DB_NAME=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# R2DBC URL with SSL configuration (for reactive PostgreSQL)
# IMPORTANT: Neon PostgreSQL requires endpoint ID for SNI support
# Format: r2dbc:postgresql://HOST:PORT/DB?sslMode=require&options=endpoint=ENDPOINT_ID
# The endpoint ID is the first part of the hostname (e.g., ep-example-xxxxx-pooler)
# NOTE: Username and password are passed separately in application.yml, NOT in the URL
DB_R2DBC_URL=r2dbc:postgresql://your-endpoint.region.aws.neon.tech:5432/your_database_name?options=endpoint%3Dyour-endpoint&sslMode=require&channelBinding=require

# JDBC URL for Flyway migrations (non-reactive)
# Includes user, password, SSL mode, and channel binding in the URL
DB_JDBC_URL=jdbc:postgresql://your-endpoint.region.aws.neon.tech/your_database_name?user=your_database_user&password=your_database_password&sslmode=require&channelBinding=require

# ============================================
# REDIS CONFIGURATION - Upstash
# ============================================
# Replace with your actual Upstash Redis credentials
# Note: Upstash Redis uses REST API, may need different configuration
REDIS_HOST=your-redis-instance.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_token
REDIS_USE_SSL=true

# Upstash REST API (if needed for REST-based access)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ============================================
# MODERATION API CONFIGURATION
# ============================================
# OpenAI Moderation API (Optional - set to true to enable)
OPENAI_MODERATION_ENABLED=false
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Perspective API (Primary Moderation Service - Google Cloud)
# Get your API key from: https://developers.perspectiveapi.com/s/docs-get-started
PERSPECTIVE_API_ENABLED=true
PERSPECTIVE_API_KEY=your_perspective_api_key_here

# Moderation Thresholds (0.0 - 1.0 probability scores)
# Lower values = stricter moderation, Higher values = more permissive
PERSPECTIVE_TOXICITY_THRESHOLD=0.7
PERSPECTIVE_SEVERE_TOXICITY_THRESHOLD=0.5
PERSPECTIVE_IDENTITY_ATTACK_THRESHOLD=0.6
PERSPECTIVE_INSULT_THRESHOLD=0.7
PERSPECTIVE_THREAT_THRESHOLD=0.5

# ============================================
# USEFUL LINKS
# ============================================
# Neon Console: https://console.neon.tech/
# Upstash Console: https://console.upstash.com/
# OpenAI API Keys: https://platform.openai.com/api-keys
# Perspective API: https://developers.perspectiveapi.com/s/docs-get-started
