# ============================================
# Root Types
# ============================================

"""
Query operations (for future read operations)
"""
type Query {
    """
    Health check query
    """
    _health: Boolean!

    """
    Validate a specific username

    Example:
    query {
        validateUsername(username: "cleverpanda42", language: EN) {
            username
            isValid
            isUnique
            isAppropriate
            isValidFormat
            reasons
            confidenceScore
            validatedAt
        }
    }
    """
    validateUsername(username: String!, language: Language = EN): ValidationResponse!
}

"""
Response containing mark-used operation results
"""
type MarkUsedResponse {
    """
    The username that was processed
    """
    username: String!

    """
    Whether the username was successfully marked as used
    """
    marked: Boolean!

    """
    Whether the username was already used before this request
    """
    wasAlreadyUsed: Boolean!

    """
    Timestamp when the username was marked as used (ISO 8601)
    """
    markedAt: String

    """
    Human-readable message describing the result
    """
    message: String!
}

"""
Mutation operations for data modification
"""
type Mutation {
    """
    Generate usernames based on language and count

    Example:
    mutation {
        generateUsernames(input: { language: EN, count: 5 }) {
            usernames
            generatedAt
            language
            totalGenerated
            cacheHit
            responseTimeMs
        }
    }
    """
    generateUsernames(input: GenerateUsernamesInput!): UsernameGenerationResponse!

    """
    Mark a username as used (claimed by a user)
    Updates database and invalidates cache layers.

    Example:
    mutation {
        markUsernameAsUsed(username: "cleverpanda42") {
            username
            marked
            wasAlreadyUsed
            markedAt
            message
        }
    }
    """
    markUsernameAsUsed(username: String!): MarkUsedResponse!
}

"""
Supported language for username generation
"""
enum Language {
    """English language"""
    EN

    """Spanish language"""
    ES
}

"""
Input for username generation request
"""
input GenerateUsernamesInput {
    """
    Language code for username generation
    """
    language: Language

    """
    Number of usernames to generate (1-10)
    Default: 1
    """
    count: Int = 1
}


"""
Response containing generated usernames and metadata
"""
type UsernameGenerationResponse {
    """
    List of generated usernames
    """
    usernames: [String!]!

    """
    Timestamp when usernames were generated (ISO 8601)
    """
    generatedAt: String!

    """
    Language used for generation
    """
    language: Language!

    """
    Total number of usernames generated
    """
    totalGenerated: Int!

    """
    Indicates if usernames were retrieved from cache
    """
    cacheHit: Boolean!

    """
    Time taken to generate usernames in milliseconds
    """
    responseTimeMs: Long!
}

"""
Response containing username validation results
"""
type ValidationResponse {
    """
    The username that was validated
    """
    username: String!

    """
    Overall validation result (true if all checks pass)
    """
    isValid: Boolean!

    """
    Username is unique (not already taken)
    """
    isUnique: Boolean!

    """
    Username passes content moderation
    """
    isAppropriate: Boolean!

    """
    Username matches format requirements
    """
    isValidFormat: Boolean!

    """
    List of validation failure reasons (empty if valid)
    """
    reasons: [String!]!

    """
    Confidence score (0.0-1.0) indicating validation certainty
    """
    confidenceScore: Float!

    """
    Timestamp when validation was performed (ISO 8601)
    """
    validatedAt: String!
}

# ============================================
# Custom Scalars
# ============================================

"""
Long scalar type for large numbers
"""
scalar Long